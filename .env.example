# Copy to .env for Docker Compose; secrets stay outside version control.
SITE_ADDRESS=dbgram.example.com
APP_ORIGIN=https://dbgram.example.com
ACME_EMAIL=you@example.com
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
JWT_SECRET=CHANGE_ME_TO_AT_LEAST_64_RANDOM_CHARACTERS

# Optional payment and moderation configuration.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
DBGRAM_ADMIN_USER_IDS=

# Optional local database UI (Compose tools profile).
ADMINER_PORT=8082
